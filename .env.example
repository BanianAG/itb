COMPOSE_PROJECT_NAME=itb

# =============================================================================
#  ITB — configuration.        cp .env.example .env
#
#  Required: the two image tags, your account, and a licence file.
#  .env is git-ignored. Keep it that way: two values below are secrets.
# =============================================================================


# ---- 1. Images --------------------------------------------------------------
# Public, no docker login. Tags: https://hub.docker.com/u/banianch
# Use the SAME tag for both — they are released as a pair.

ITB_REGISTRY=banianch
ITB_API_IMAGE=itb-api
ITB_API_TAG=latest
ITB_CLIENT_IMAGE=itb-client
ITB_CLIENT_TAG=latest


# ---- 2. Licence -------------------------------------------------------------
# Required. The API verifies it at startup and exits if it is missing or expired.
# Free of charge: https://itb.banian.ch/license/
# Save the file you get back next to this one.

ITB_LICENSE_FILE=./license.json


# ---- 3. Your account --------------------------------------------------------
# Required, and EXACTLY ONE. A second account here does not degrade gracefully:
# the API refuses to start (exit 27).
# Format is user:sha256hex, NOT the plaintext password (plaintext gives a 401
# that looks like a wrong password).
#
#     printf 'your-password' | sha256sum          # Linux, macOS
#
#     ITB_AUTH_USERS=you@example.com:<64 hex characters>
#
# Worked example. The hash is sha256 of the password ChangeMe123!
# Try it once to confirm login works, then replace it with your own.
#
#     ITB_AUTH_USERS=you@example.com:<64 hex characters>
#
#     login     admin@example.com
#     password  ChangeMe123!
#     ITB_AUTH_USERS=admin@example.com:9a4aabf0e5cf71cae2cea646613ce7e2a5919fa758e56819704be25a3a2c1f0b

ITB_AUTH_MODE=local
ITB_AUTH_USERS=


# ---- 4. Keys ----------------------------------------------------------------
# Both optional, both `openssl rand -hex 32`.
#
#   ITB_JWT_SECRET       empty = a new key per start, so a restart logs you out
#   ITB_CREDENTIAL_KEY   encrypts credentials you store in ITB (a database, a Git
#                        remote). Changing it makes existing ones unreadable.

ITB_JWT_SECRET=
ITB_CREDENTIAL_KEY=


# ---- Ports and URLs ---------------------------------------------------------
# Change ITB_HTTP_PORT if 80 is taken. ITB_API_URL and ITB_CORS_ALLOW_ORIGINS
# then need the port too (http://itb.localhost:8081). ./itb.sh does that for you.
# ITB_API_URL is handed to the BROWSER, so it must be the URL you type.

ITB_HTTP_PORT=80
ITB_DASHBOARD_PORT=8080
ITB_API_URL=http://api.itb.localhost


# ---- Browser origins --------------------------------------------------------
# Where the app is served from. App and API are different origins, so the API
# has to allow it. Empty blocks every call from the app, and the app then
# reports "Service Dependencies Unavailable" — which looks like the API is down.
# Several origins: comma-separated.

ITB_CORS_ALLOW_ORIGINS=http://itb.localhost


# ---- Proxy ------------------------------------------------------------------
# Any Traefik 3.x.

ITB_PROXY_IMAGE=traefik:3.7.13
